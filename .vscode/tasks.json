{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Application (mvn package)",
            "type": "shell",
            "command": ".\\mvnw.cmd package",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$maven"
        },
        {
            "label": "Run Tests (mvn test)",
            "type": "shell",
            "command": ".\\mvnw.cmd test",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$maven"
        }
    ]
}
